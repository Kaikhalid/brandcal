# Environment variables for brandcal CLI in remote mode (see docs/BOT_INTEGRATION.md).
# Copy this file to .env (which is git-ignored) and fill in your real values.
# Never commit .env or print the service-token secret.

# Base HTTPS URL of your hosted brandcal Worker (no trailing slash).
BRANDCAL_REMOTE=https://brandcal.example.com

# Cloudflare Access service token client ID (ends in .access).
# Must also be listed in serve.service_tokens inside D1 meta.config.
BRANDCAL_ACCESS_CLIENT_ID=00000000-0000-0000-0000-000000000000.access

# Cloudflare Access service token client secret.
# Sent only as the CF-Access-Client-Secret header; never printed, logged or committed.
BRANDCAL_ACCESS_CLIENT_SECRET=replace-with-your-access-client-secret

# Optional default agent identity for write commands (can also be passed per command with --as).
# BRANDCAL_AGENT=manager-1
